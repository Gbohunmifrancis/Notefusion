# Build context for the C# API is the repo root. Keep the context small and avoid
# leaking build outputs / secrets / the other stacks into the image layer.

**/bin/
**/obj/
**/.vs/
**/.git/
**/*.pdb

# Host-installed node modules.
**/node_modules/

# Other stacks
mobile/
server/
docs/
web-admin/

# Local env / secrets.
**/.env
**/*.env
**/.env.*
**/*.pfx
**/*.pem

# Editor / OS cruft
**/.DS_Store
**/*.user
