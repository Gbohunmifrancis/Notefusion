# Build context for the C# API is the repo root. Keep the context small and avoid
# leaking build outputs / secrets / the other stacks into the image layer.

**/bin/
**/obj/
**/.vs/
**/.git/

# Host-installed node modules. Nothing in this image is built from JavaScript, and copying
# these in would both bloat the context and risk shipping win32-native binaries.
**/node_modules/

# Other stacks — not part of the API image. web-admin/ was built into wwwroot here once; it is
# a separate Next.js app deployed to Vercel now, so the whole folder stays out of the context.
mobile/
server/
spike/
docs/
web-admin/

# Local env / secrets.
**/.env
**/*.env
**/.env.*
**/*.pfx
**/*.pem

# Editor / OS cruft
**/.DS_Store
**/*.user
