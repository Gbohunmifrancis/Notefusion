{
  "expo": {
    "name": "NoteFusion",
    "slug": "notefusion",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "notefusion",
    "userInterfaceStyle": "light",
    "backgroundColor": "#F8FAFC",
    "icon": "./assets/icon.png",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.notefusion",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "NoteFusion records short clips to transcribe them into solfa and staff notation."
      }
    },
    "android": {
      "package": "app.notefusion",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#2563EB"
      },
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ]
    },
    "plugins": [
      "expo-secure-store",
      "expo-notifications",
      [
        "expo-audio",
        {
          "microphonePermission": "NoteFusion records short clips to transcribe them into solfa and staff notation."
        }
      ],
      "expo-asset",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 120,
          "resizeMode": "contain",
          "backgroundColor": "#1D6FF2"
        }
      ],
      "expo-sharing",
      "expo-web-browser"
    ],
    "extra": {
      "apiBaseUrl": "https://notefusion-api-3c2513a1e974.herokuapp.com",
      "googleIosClientId": "21738378819-3prjgka9cpf6c2l3si6q879vgm06kf6h.apps.googleusercontent.com",
      "googleAndroidClientId": "21738378819-phjudqm26h6sthgfj0e2eg0l0vnid8ca.apps.googleusercontent.com",
      "googleWebClientId": "21738378819-3prjgka9cpf6c2l3si6q879vgm06kf6h.apps.googleusercontent.com",
      "eas": {
        "projectId": "a83ae670-e248-485e-95f7-686608f515ad"
      }
    },
    "owner": "fransix66"
  }
}
