{
  "expo": {
    "name": "NoteFusion",
    "slug": "notefusion",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "notefusion",
    "userInterfaceStyle": "dark",
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.notefusion",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "NoteFusion records short clips to transcribe them into solfa and staff notation."
      }
    },
    "android": {
      "package": "app.notefusion",
      "adaptiveIcon": {
        "backgroundColor": "#000000"
      },
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ]
    },
    "plugins": [
      "expo-secure-store",
      "expo-notifications",
      [
        "expo-audio",
        {
          "microphonePermission": "NoteFusion records short clips to transcribe them into solfa and staff notation."
        }
      ],
      "expo-asset",
      "expo-splash-screen"
    ],
    "extra": {
      "apiBaseUrl": "https://notefusion-api-3c2513a1e974.herokuapp.com",
      "eas": {
        "projectId": "a83ae670-e248-485e-95f7-686608f515ad"
      }
    },
    "owner": "fransix66"
  }
}
