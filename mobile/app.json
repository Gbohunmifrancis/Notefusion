{
  "expo": {
    "name": "NoteFusion",
    "slug": "notefusion",
    "version": "1.0.0",
    "orientation": "default",
    "scheme": "notefusion",
    "userInterfaceStyle": "light",
    "backgroundColor": "#F8FAFC",
    "icon": "./assets/icon.png",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "requireFullScreen": true,
      "bundleIdentifier": "com.notefusion.com",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "NoteFusion records short clips to transcribe them into solfa and staff notation."
      }
    },
    "android": {
      "package": "com.notefusion.com",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#2563EB"
      },
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ]
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "icon": "./assets/brand/mark.png",
          "color": "#2563EB"
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "NoteFusion records short clips to transcribe them into solfa and staff notation."
        }
      ],
      "expo-asset",
      [
        "expo-image-picker",
        {
          "photosPermission": "NoteFusion lets you pick a photo from your library to use as your profile picture.",
          "cameraPermission": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 90,
          "resizeMode": "contain",
          "backgroundColor": "#1D6FF2"
        }
      ],
      "expo-sharing",
      "expo-web-browser"
    ],
    "extra": {
      "apiBaseUrl": "https://notefusion-api-3c2513a1e974.herokuapp.com",
      "googleIosClientId": "",
      "googleAndroidClientId": "21738378819-phjudqm26h6sthgfj0e2eg0l0vnid8ca.apps.googleusercontent.com",
      "googleWebClientId": "21738378819-3prjgka9cpf6c2l3si6q879vgm06kf6h.apps.googleusercontent.com",
      "eas": {
        "projectId": "8cc4d615-18ab-4e92-8ae7-77087b84bfab"
      }
    },
    "owner": "yaw669",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/8cc4d615-18ab-4e92-8ae7-77087b84bfab"
    }
  }
}
