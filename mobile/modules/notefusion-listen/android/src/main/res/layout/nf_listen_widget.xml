<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@+id/nf_widget_root"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:background="@drawable/nf_widget_bg"
  android:gravity="center"
  android:orientation="vertical"
  android:padding="12dp">
  <ImageView
    android:layout_width="56dp"
    android:layout_height="56dp"
    android:contentDescription="@string/nf_widget_button"
    android:src="@drawable/nf_tile_icon"
    android:tint="#FFFFFF" />
  <TextView
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginTop="8dp"
    android:text="@string/nf_widget_button"
    android:textColor="#FFFFFF"
    android:textSize="15sp"
    android:textStyle="bold" />
  <TextView
    android:id="@+id/nf_widget_last"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginTop="4dp"
    android:gravity="center"
    android:maxLines="2"
    android:textColor="#DDE7FF"
    android:textSize="12sp" />
</LinearLayout>
