<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <uses-permission android:name="android.permission.RECORD_AUDIO" />
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
  <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

  <application>
    <!-- The microphone foreground service that keeps listening for the key while another app plays. -->
    <service
      android:name="expo.modules.notefusionlisten.KeyListenerService"
      android:exported="false"
      android:foregroundServiceType="microphone" />

    <!-- Quick Settings tile: pull down the shade, tap "Find the key". -->
    <service
      android:name="expo.modules.notefusionlisten.ListenTileService"
      android:exported="true"
      android:icon="@drawable/nf_tile_icon"
      android:label="@string/nf_tile_label"
      android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
      <intent-filter>
        <action android:name="android.service.quicksettings.action.QS_TILE" />
      </intent-filter>
      <meta-data android:name="android.service.quicksettings.TOGGLEABLE_TILE" android:value="false" />
    </service>

    <!-- Home-screen widget: one big "Tap to find the key" button + the last key found. -->
    <receiver
      android:name="expo.modules.notefusionlisten.ListenWidgetProvider"
      android:exported="false"
      android:label="@string/nf_widget_label">
      <intent-filter>
        <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
      </intent-filter>
      <meta-data android:name="android.appwidget.provider" android:resource="@xml/nf_listen_widget_info" />
    </receiver>
  </application>
</manifest>
