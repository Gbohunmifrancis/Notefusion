# Cloudflare (Workers static assets): the site's headers, as Vercel's vercel.json gave them until the move.
# A path matching several rules gets every rule's headers; the same header twice is joined with a comma, and
# "! Name" drops one a broader rule set. Lines may be at most 2,000 characters.

/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: microphone=(self), camera=(), geolocation=()
  Cross-Origin-Resource-Policy: same-site
  Content-Security-Policy: object-src 'none'; base-uri 'self'; frame-ancestors 'none'
  Content-Security-Policy-Report-Only: default-src 'self'; script-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net/npm/opensheetmusicdisplay@2.1.2/ https://pagead2.googlesyndication.com https://*.googlesyndication.com https://*.doubleclick.net https://*.google.com https://*.gstatic.com https://*.adtrafficquality.google https://www.googletagservices.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: blob: https:; connect-src 'self' https://api.notefusion.studio https://*.googlesyndication.com https://*.doubleclick.net https://*.google.com https://*.adtrafficquality.google; frame-src https://*.googlesyndication.com https://*.doubleclick.net https://*.google.com https://*.adtrafficquality.google; media-src 'self' blob: data:; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'

# /app: its own policy. The site-wide one above (object-src, base-uri, frame-ancestors) is a subset of it, so both
# being enforced is the same as /app's alone; the ads' report-only policy is the site's, not the app's.
/app
  ! Content-Security-Policy-Report-Only
  Content-Security-Policy: default-src 'self'; script-src 'self' https://cdnjs.cloudflare.com/ajax/libs/jspdf/4.2.1/ https://cdn.jsdelivr.net/npm/opensheetmusicdisplay@2.1.2/ https://accounts.google.com/gsi/client; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://accounts.google.com/gsi/style; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: blob: https:; connect-src 'self' https://api.notefusion.studio https://o4508111757770752.ingest.us.sentry.io https://accounts.google.com/gsi/; frame-src https://accounts.google.com/gsi/; media-src 'self' blob: data:; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'

/app/*
  ! Content-Security-Policy-Report-Only
  Content-Security-Policy: default-src 'self'; script-src 'self' https://cdnjs.cloudflare.com/ajax/libs/jspdf/4.2.1/ https://cdn.jsdelivr.net/npm/opensheetmusicdisplay@2.1.2/ https://accounts.google.com/gsi/client; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://accounts.google.com/gsi/style; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: blob: https:; connect-src 'self' https://api.notefusion.studio https://accounts.google.com/gsi/; frame-src https://accounts.google.com/gsi/; media-src 'self' blob: data:; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'

# Fonts never change under a name. Every other file is served with Cloudflare's default (revalidated each time),
# what vercel.json gave CSS, JS and SVG; a changed CSS/JS file still gets a new ?v.
/assets/fonts/*
  Cache-Control: public, max-age=31536000, immutable

/sw.js
  Cache-Control: no-cache

/email/*
  Cache-Control: public, max-age=604800, must-revalidate
  ! Cross-Origin-Resource-Policy

# Mail apps and other sites load these: no same-site lock (no header is the same as cross-origin).
/assets/*
  ! Cross-Origin-Resource-Policy
