# Production build, read by `next build`, and so by the Cloudflare deploy (deploy-admin.yml).
#
# The dashboard is served from admin.notefusion.studio and the API from Heroku, so calls are
# cross-origin and need an absolute base URL. That origin must also be in the API's CORS
# allow-list â€” see src/NoteFusion.Api/Program.cs.
#
# Not a secret: it is the same public URL the mobile app calls, and `NEXT_PUBLIC_` means it is
# inlined into the client bundle either way. Committed so a clean clone builds a working app
# without depending on a setting anywhere else.
NEXT_PUBLIC_API_URL=https://api.notefusion.studio
