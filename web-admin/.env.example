# Base URL of the C# Web API. No trailing slash.
#
# Local dev with `dotnet run` from src/NoteFusion.Api uses the port in that project's
# launchSettings.json, which is NOT 5080 — check the "Now listening on" line it prints.
# `docker compose up` publishes the API on 5080.
VITE_API_URL=http://localhost:5080
